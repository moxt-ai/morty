{
    "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
    "vcs": {
        "enabled": true,
        "clientKind": "git",
        "defaultBranch": "main",
        "useIgnoreFile": true
    },
    "files": {
        "includes": [
            "**",
            "!!**/dist",
            "!!**/coverage",
            "!!**/.wrangler",
            "!!worker-configuration.d.ts",
            "!!**/test-results",
            "!!**/playwright-report",
            "!!**/worker-configuration.d.ts"
        ]
    },
    "linter": {
        "enabled": true,
        "domains": {
            "project": "recommended",
            "react": "recommended",
            "types": "recommended",
            "test": "recommended"
        },
        "rules": {
            "preset": "recommended",
            "complexity": {
                "useLiteralKeys": "off"
            },
            "style": {
                "useBlockStatements": "error"
            },
            "nursery": {
                "noFloatingPromises": "error",
                "noMisusedPromises": "error",
                "useExhaustiveSwitchCases": "error"
            }
        }
    },
    "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "indentWidth": 4,
        "lineWidth": 120
    },
    "css": {
        "parser": {
            "tailwindDirectives": true
        }
    },
    "overrides": [
        {
            "includes": [
                "**",
                "!!packages/web/src/components/**",
                "!!packages/web/tests/**",
                "!!**/*.test.ts",
                "!!**/*.test.tsx",
                "!!**/tests/**",
                "!!packages/admin/**"
            ],
            "linter": {
                "rules": {
                    "style": {
                        "noRestrictedImports": {
                            "level": "error",
                            "options": {
                                "paths": {
                                    "react": {
                                        "message": "React hooks are only allowed in packages/web/src/components (useLayoutEffect further only in components/utils); views must subscribe to view-model stores and let components own DOM-ephemeral state.",
                                        "importNames": [
                                            "useState",
                                            "useEffect",
                                            "useRef",
                                            "useReducer",
                                            "useMemo",
                                            "useCallback",
                                            "useLayoutEffect",
                                            "useInsertionEffect"
                                        ]
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        {
            "includes": ["packages/web/src/components/**", "!!packages/web/src/components/utils/**"],
            "linter": {
                "rules": {
                    "style": {
                        "noRestrictedImports": {
                            "level": "error",
                            "options": {
                                "paths": {
                                    "react": {
                                        "message": "useLayoutEffect is only allowed in packages/web/src/components/utils; move the layout effect into a util there and compose it.",
                                        "importNames": ["useLayoutEffect"]
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        {
            "includes": [
                "packages/cli/src/engine/acp/harness/claude/upstream/src/**/*.ts",
                "packages/cli/src/engine/acp/harness/pi/upstream/**/*.ts"
            ],
            "linter": {
                "rules": {
                    "suspicious": {
                        "noExplicitAny": "off"
                    }
                }
            }
        }
    ],
    "plugins": [
        {
            "path": "./config/lint/no-type-assertions.grit",
            "includes": [
                "**/packages/*/src/**",
                "**/packages/web/**",
                "**/packages/worker/**",
                "**/packages/setup/**",
                "**/packages/e2e/**",
                "**/packages/local-state/**",
                "**/scripts/**",
                "!**/packages/cli/src/engine/acp/harness/*/upstream/**"
            ]
        }
    ]
}
