{
    "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
    "vcs": {
        "enabled": true,
        "clientKind": "git",
        "defaultBranch": "main",
        "useIgnoreFile": true
    },
    "files": {
        "includes": [
            "**",
            "!!**/dist",
            "!!**/coverage",
            "!!**/.wrangler",
            "!!third-party",
            "!!worker-configuration.d.ts",
            "!!**/test-results",
            "!!**/playwright-report"
        ]
    },
    "linter": {
        "enabled": true,
        "domains": {
            "project": "recommended",
            "react": "recommended",
            "types": "recommended",
            "test": "recommended"
        },
        "rules": {
            "preset": "recommended",
            "complexity": {
                "useLiteralKeys": "off"
            },
            "style": {
                "useBlockStatements": "error"
            },
            "nursery": {
                "noFloatingPromises": "error",
                "noMisusedPromises": "error",
                "useExhaustiveSwitchCases": "error"
            }
        }
    },
    "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "indentWidth": 4,
        "lineWidth": 120
    },
    "css": {
        "parser": {
            "tailwindDirectives": true
        }
    },
    "overrides": [
        {
            "includes": ["**", "!!packages/web/src/components/utils/**"],
            "linter": {
                "rules": {
                    "style": {
                        "noRestrictedImports": {
                            "level": "error",
                            "options": {
                                "paths": {
                                    "react": {
                                        "message": "useLayoutEffect is only allowed in packages/web/src/components/utils; move the layout effect into a util there and compose it.",
                                        "importNames": ["useLayoutEffect"]
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    ],
    "plugins": ["./config/lint/no-type-assertions.grit"]
}
