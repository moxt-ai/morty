{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "app-slack",
    "main": "src/worker.ts",
    "compatibility_date": "2026-09-04",
    "compatibility_flags": ["nodejs_compat"],
    "queues": {
        "producers": [{ "binding": "EVENTS", "queue": "app-slack-events" }],
        "consumers": [
            {
                "queue": "app-slack-events",
                "max_batch_size": 1,
                "max_retries": 5
            }
        ]
    },
    "r2_buckets": [{ "binding": "ATTACHMENTS", "bucket_name": "app-slack-attachments" }],
    "d1_databases": [
        {
            "binding": "DATABASE",
            "database_name": "app-slack",
            "database_id": "replace-with-production-d1-id",
            "migrations_dir": "migrations"
        }
    ],
    "durable_objects": {
        "bindings": [
            {
                "name": "BOT_TRIGGER_RATE_LIMITER",
                "class_name": "BotTriggerRateLimiter"
            }
        ]
    },
    "migrations": [
        {
            "tag": "v1",
            "new_sqlite_classes": ["AgentTriggerRateLimiter"]
        },
        {
            "tag": "bot-trigger-v2",
            "renamed_classes": [{ "from": "AgentTriggerRateLimiter", "to": "BotTriggerRateLimiter" }]
        }
    ],
    "assets": {
        "binding": "ASSETS",
        "directory": "../web/dist",
        "html_handling": "auto-trailing-slash",
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/mobius-slack/api/*"]
    },
    "observability": {
        "enabled": true
    },
    "env": {
        "staging": {
            "name": "mobius-slack-staging",
            "account_id": "95af7a3d67be8c49b1619544e3ce53c0",
            "workers_dev": true,
            "queues": {
                "producers": [{ "binding": "EVENTS", "queue": "mobius-slack-staging-events" }],
                "consumers": [
                    {
                        "queue": "mobius-slack-staging-events",
                        "max_batch_size": 1,
                        "max_retries": 5
                    }
                ]
            },
            "r2_buckets": [{ "binding": "ATTACHMENTS", "bucket_name": "mobius-slack-staging-attachments" }],
            "d1_databases": [
                {
                    "binding": "DATABASE",
                    "database_name": "mobius-slack-staging",
                    "database_id": "44f698c5-a0c6-4353-938e-eca4a9df1edb",
                    "migrations_dir": "migrations"
                }
            ],
            "durable_objects": {
                "bindings": [
                    {
                        "name": "BOT_TRIGGER_RATE_LIMITER",
                        "class_name": "BotTriggerRateLimiter"
                    }
                ]
            }
        }
    }
}
