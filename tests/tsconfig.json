{
    "extends": "../tsconfig.json",
    "compilerOptions": {
        "types": ["node", "vite/client"],
        "jsx": "react-jsx",
        "lib": ["es2024", "dom", "dom.iterable"]
    },
    "include": [
        "**/*.ts",
        "../scripts/**/*.ts",
        "../packages/worker/src/**/*.ts",
        "../vitest.config.ts",
        "../worker-configuration.d.ts",
        "../shared/**/*.ts",
        "../vite.config.ts",
        "**/*.tsx",
        "../vitest.browser.config.ts",
        "../web/**/*.ts",
        "../web/**/*.tsx"
    ]
}
