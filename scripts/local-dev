#!/bin/sh
set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
case "${1:-}" in
    web-server|web-server-morty-cli)
        MODE=$1
        shift
        exec node "$ROOT/scripts/local-dev.cjs" prepare "$MODE" "$@"
        ;;
    *)
        exec node "$ROOT/scripts/local-dev.cjs" "$@"
        ;;
esac
