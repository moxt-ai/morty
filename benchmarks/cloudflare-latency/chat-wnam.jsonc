{
    "$schema": "../../node_modules/wrangler/config-schema.json",
    "name": "mobius-latency-chat-wnam",
    "main": "worker.ts",
    "compatibility_date": "2026-09-07",
    "account_id": "95af7a3d67be8c49b1619544e3ce53c0",
    "placement": { "region": "aws:us-west-2" },
    "workers_dev": true,
    "preview_urls": false,
    "vars": {
        "PROBE_NAME": "mobius-chat-wnam",
        "TARGET_URL": "https://mobius.moxt.ai/mobius/api/health"
    },
    "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "mobius-chat-staging-wnam-attachments" }],
    "d1_databases": [
        {
            "binding": "DATABASE",
            "database_name": "mobius-chat-staging-wnam",
            "database_id": "51e83fb8-70ef-4c68-98b2-5a6481fc0fc9"
        }
    ]
}
