{
    "$schema": "../../node_modules/wrangler/config-schema.json",
    "name": "mobius-latency-platform-wnam-01",
    "main": "worker.ts",
    "compatibility_date": "2026-09-03",
    "account_id": "95af7a3d67be8c49b1619544e3ce53c0",
    "placement": { "region": "aws:us-west-2" },
    "workers_dev": true,
    "preview_urls": false,
    "vars": { "PROBE_NAME": "platform-wnam-01" },
    "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "mobius-cloud-production-wnam-objects" }],
    "d1_databases": [
        {
            "binding": "DATABASE",
            "database_name": "mobius-cloud-production-wnam-01",
            "database_id": "5e809606-9770-48ae-9c38-046903b0daa8"
        }
    ]
}
