{
    "$schema": "https://unpkg.com/knip@6/schema.json",
    "ignore": ["third-party/**"],
    "ignoreDependencies": ["cloudflare"],
    "workspaces": {
        ".": {
            "entry": ["benchmarks/cloudflare-latency/run.mjs", "benchmarks/cloudflare-latency/worker.ts"]
        },
        "packages/e2e": {
            "entry": ["*.e2e.test.ts", "fixtures/local-platform-worker.ts", "infra/acp-proxy.ts"]
        },
        "packages/web": {
            "entry": [
                "src/main.tsx",
                "src/views/chat/app.tsx",
                "src/views/applications/slack-management.tsx",
                "src/components/ui/*.tsx"
            ]
        }
    }
}
