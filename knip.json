{
    "$schema": "https://unpkg.com/knip@6/schema.json",
    "ignore": ["third-party/**"],
    "ignoreDependencies": ["cloudflare", "drizzle-kit"],
    "workspaces": {
        ".": {
            "entry": ["drizzle/*.config.ts", ".agents/skills/*/scripts/*.{ts,cjs}"]
        },
        "packages/e2e": {
            "entry": ["*.e2e.test.ts", "fixtures/local-platform-worker.ts", "infra/acp-proxy.ts", "live/*.mjs"]
        },
        "packages/web": {
            "entry": [
                "src/main.tsx",
                "src/views/chat/app.tsx",
                "src/views/applications/slack-management.tsx",
                "src/components/ui/*.tsx"
            ]
        },
        "packages/worker": {
            "entry": ["src/index.ts", "src/schema/*/index.ts"]
        }
    }
}
