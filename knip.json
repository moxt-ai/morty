{
    "$schema": "https://unpkg.com/knip@6/schema.json",
    "workspaces": {
        ".": {
            "entry": [
                "drizzle/*.config.ts",
                "vite.web-dev.config.ts",
                ".agents/skills/*/scripts/*.{ts,cjs}",
                "deployment/verify-session-access.ts",
                "dependency-cruiser.config.cjs"
            ]
        },
        "packages/e2e": {
            "entry": ["*.e2e.test.ts", "release-acceptance.mjs"]
        },
        "packages/web": {
            "entry": ["src/main.tsx", "tests/**/*.integration.test.tsx"],
            "includeEntryExports": true
        },
        "packages/worker": {
            "entry": ["src/index.ts", "src/computer-relay/schema/**/*.ts", "tests/relay/**/*.integration.test.ts"]
        },
        "packages/cli": {
            "entry": [
                "tests/**/*.test.{ts,mjs}",
                "src/engine/acp/harness/claude/upstream/src/lib.ts",
                "src/engine/acp/harness/pi/upstream/acp/agent.ts"
            ],
            "ignoreDependencies": ["drizzle-kit"],
            "includeEntryExports": true
        },
        "packages/client": {
            "includeEntryExports": true
        },
        "packages/relay-test-support": {
            "entry": ["src/worker-entry.ts"]
        },
        "packages/local-state": {
            "includeEntryExports": true
        },
        "packages/runtime-test-support": {
            "includeEntryExports": true
        }
    },
    "ignoreBinaries": ["openssl"],
    "ignore": ["packages/cli/src/engine/acp/harness/*/upstream/**"]
}
