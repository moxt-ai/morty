{
    "$schema": "https://unpkg.com/knip@6/schema.json",
    "ignoreDependencies": ["cloudflare"],
    "workspaces": {
        ".": {
            "entry": [
                "drizzle/*.config.ts",
                "vite.web-dev.config.ts",
                ".agents/skills/*/scripts/*.{ts,cjs}",
                "deployment/verify-session-access.ts",
                "scripts/prepare-claude-desktop.ts"
            ]
        },
        "packages/e2e": {
            "entry": ["*.e2e.test.ts", "release-acceptance.mjs"]
        },
        "packages/web": {
            "entry": ["src/main.tsx", "tests/**/*.integration.test.tsx", "src/components/ui/*.tsx"]
        },
        "packages/worker": {
            "entry": ["src/index.ts", "src/schema/*/index.ts"]
        },
        "packages/cli": {
            "entry": [
                "tests/**/*.test.{ts,mjs}",
                "tests/pressure/*.mjs",
                "src/engine/acp/harness/claude/upstream/src/lib.ts",
                "src/engine/acp/harness/pi/upstream/acp/agent.ts"
            ],
            "ignoreDependencies": ["drizzle-kit"]
        },
        "packages/client": {
            "entry": ["tests/*-types.contract.ts"]
        },
        "packages/relay": {
            "entry": ["src/schema/**/*.ts"]
        },
        "packages/relay-test-support": {
            "entry": ["src/relay-worker-entry.ts"]
        }
    },
    "ignoreBinaries": ["openssl"],
    "ignore": ["packages/cli/src/engine/acp/harness/*/upstream/**"]
}
