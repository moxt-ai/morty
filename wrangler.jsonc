{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "mobius-cloud-local",
    "main": "worker/index.ts",
    "compatibility_date": "2026-09-07",
    "keep_vars": true,
    "workers_dev": true,
    "preview_urls": false,
    "observability": {
        "enabled": true,
        "logs": {
            "enabled": true,
            "invocation_logs": true
        }
    },
    "assets": {
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/mobius-cloud/api/*", "/mobius/api/*", "/mobius-slack/api/*"]
    },
    "queues": {
        "producers": [{ "binding": "EVENTS", "queue": "app-slack-events" }],
        "consumers": [{ "queue": "app-slack-events", "max_batch_size": 1, "max_retries": 5 }]
    },
    "r2_buckets": [
        { "binding": "R2_BUCKET_APAC", "bucket_name": "app-slack-attachments" },
        { "binding": "R2_BUCKET_WNAM", "bucket_name": "mobius-cloud-local-wnam-objects" }
    ],
    "d1_databases": [
        {
            "binding": "D1_SHARD_APAC_01",
            "database_name": "app-slack",
            "database_id": "replace-with-production-d1-id",
            "migrations_dir": "apps/slack/packages/worker/migrations"
        },
        {
            "binding": "D1_SHARD_WNAM_01",
            "database_name": "mobius-cloud-local-wnam-01",
            "database_id": "00000000-0000-0000-0000-000000000002",
            "migrations_dir": "apps/slack/packages/worker/migrations"
        },
        {
            "binding": "DIRECTORY_DATABASE",
            "database_name": "mobius-directory",
            "migrations_dir": "mobius/packages/relay-cloudflare/migrations/d1"
        }
    ],
    "durable_objects": {
        "bindings": [
            {
                "name": "AGENT_TRIGGER_RATE_LIMITER",
                "class_name": "AgentTriggerRateLimiter"
            },
            {
                "name": "RUNTIME_RELAY",
                "class_name": "RuntimeRelay"
            },
            {
                "name": "SESSION_RELAY",
                "class_name": "LiteSessionRelay"
            },
            {
                "name": "TENANT_PLACEMENT_ALLOCATOR",
                "class_name": "TenantPlacementAllocator"
            }
        ]
    },
    "vars": {
        "DEPLOY_ENVIRONMENT": "staging",
        "SESSION_ACTIVE_SESSIONS_PER_PROJECT": "1000",
        "SESSION_ACTIVE_SESSIONS_PER_TENANT": "10000",
        "SESSION_ARCHIVE_BYTES_PER_SESSION": "268435456"
    },
    "migrations": [
        {
            "tag": "slack-v1",
            "new_sqlite_classes": ["AgentTriggerRateLimiter"]
        },
        {
            "tag": "mobius-v1",
            "new_sqlite_classes": ["RuntimeRelay", "SessionRelay"]
        },
        {
            "tag": "mobius-v2",
            "new_sqlite_classes": ["LiteSessionRelay"]
        },
        {
            "tag": "tenant-placement-v1",
            "new_sqlite_classes": ["TenantPlacementAllocator"]
        }
    ],
    "env": {
        "staging": {
            "name": "mobius-cloud-staging",
            "secrets": {
                "required": [
                    "APP_ORIGIN",
                    "AUTHENTICATION_BASE_URL",
                    "CLERK_ISSUER_URL",
                    "CLERK_PUBLISHABLE_KEY",
                    "CLERK_JWT_KEY",
                    "CLERK_SECRET_KEY",
                    "MOBIUS_BASE_URL",
                    "SLACK_MOBIUS_AUTH_TOKEN",
                    "SLACK_OAUTH_STATE_SIGNING_KEY",
                    "SLACK_SERVER_BASE_URL",
                    "SLACK_TOKEN_ENCRYPTION_KEY"
                ]
            },
            "vars": {
                "DEPLOY_ENVIRONMENT": "staging",
                "SESSION_ACTIVE_SESSIONS_PER_PROJECT": "1000",
                "SESSION_ACTIVE_SESSIONS_PER_TENANT": "10000",
                "SESSION_ARCHIVE_BYTES_PER_SESSION": "268435456"
            },
            "routes": [
                {
                    "pattern": "mobius.paradev.biz",
                    "custom_domain": true
                }
            ],
            "workers_dev": false,
            "queues": {
                "producers": [
                    {
                        "binding": "EVENTS",
                        "queue": "mobius-slack-cloud-staging-events"
                    }
                ],
                "consumers": [
                    {
                        "queue": "mobius-slack-cloud-staging-events",
                        "max_batch_size": 1,
                        "max_retries": 5
                    }
                ]
            },
            "r2_buckets": [
                { "binding": "R2_BUCKET_APAC", "bucket_name": "mobius-cloud-staging-apac-objects" },
                { "binding": "R2_BUCKET_WNAM", "bucket_name": "mobius-cloud-staging-wnam-objects" }
            ],
            "d1_databases": [
                {
                    "binding": "D1_SHARD_APAC_01",
                    "database_name": "mobius-cloud-staging-apac-01",
                    "database_id": "76a58022-7ee3-4faf-9cc2-db458231cd2e"
                },
                {
                    "binding": "D1_SHARD_WNAM_01",
                    "database_name": "mobius-cloud-staging-wnam-01",
                    "database_id": "bbdd94bf-f098-409a-b8d9-2bdbf6d2eda7"
                },
                {
                    "binding": "DIRECTORY_DATABASE",
                    "database_name": "mobius-cloud-staging-apac-01",
                    "database_id": "76a58022-7ee3-4faf-9cc2-db458231cd2e",
                    "migrations_dir": "mobius/packages/relay-cloudflare/migrations/d1"
                }
            ],
            "durable_objects": {
                "bindings": [
                    { "name": "TENANT_PLACEMENT_ALLOCATOR", "class_name": "TenantPlacementAllocator" },
                    {
                        "name": "AGENT_TRIGGER_RATE_LIMITER",
                        "class_name": "AgentTriggerRateLimiter"
                    },
                    {
                        "name": "RUNTIME_RELAY",
                        "class_name": "RuntimeRelay"
                    },
                    {
                        "name": "SESSION_RELAY",
                        "class_name": "LiteSessionRelay"
                    }
                ]
            }
        },
        "production": {
            "name": "mobius-cloud-production",
            "secrets": {
                "required": [
                    "APP_ORIGIN",
                    "AUTHENTICATION_BASE_URL",
                    "CLERK_ISSUER_URL",
                    "CLERK_PUBLISHABLE_KEY",
                    "CLERK_JWT_KEY",
                    "CLERK_SECRET_KEY",
                    "MOBIUS_BASE_URL",
                    "SLACK_MOBIUS_AUTH_TOKEN",
                    "SLACK_OAUTH_STATE_SIGNING_KEY",
                    "SLACK_SERVER_BASE_URL",
                    "SLACK_TOKEN_ENCRYPTION_KEY"
                ]
            },
            "vars": {
                "DEPLOY_ENVIRONMENT": "production",
                "SESSION_ACTIVE_SESSIONS_PER_PROJECT": "1000",
                "SESSION_ACTIVE_SESSIONS_PER_TENANT": "10000",
                "SESSION_ARCHIVE_BYTES_PER_SESSION": "268435456"
            },
            "routes": [
                {
                    "pattern": "mobius.paraflow.biz",
                    "custom_domain": true
                }
            ],
            "workers_dev": false,
            "d1_databases": [
                {
                    "binding": "D1_SHARD_APAC_01",
                    "database_name": "mobius-cloud-production-apac-01",
                    "database_id": "9ba3f0bb-59f4-4a43-bf51-2a2317e75d01"
                },
                {
                    "binding": "D1_SHARD_APAC_02",
                    "database_name": "mobius-cloud-production-apac-02",
                    "database_id": "c20de4d5-4d9b-4ed2-b11f-fd660124de2d"
                },
                {
                    "binding": "D1_SHARD_WNAM_01",
                    "database_name": "mobius-cloud-production-wnam-01",
                    "database_id": "5e809606-9770-48ae-9c38-046903b0daa8"
                },
                {
                    "binding": "D1_SHARD_WNAM_02",
                    "database_name": "mobius-cloud-production-wnam-02",
                    "database_id": "67c6aacd-29d1-4e0b-ae87-5a45d4ff69e3"
                },
                {
                    "binding": "DIRECTORY_DATABASE",
                    "database_name": "mobius-cloud-production-apac-01",
                    "database_id": "9ba3f0bb-59f4-4a43-bf51-2a2317e75d01",
                    "migrations_dir": "mobius/packages/relay-cloudflare/migrations/d1"
                }
            ],
            "durable_objects": {
                "bindings": [
                    { "name": "TENANT_PLACEMENT_ALLOCATOR", "class_name": "TenantPlacementAllocator" },
                    {
                        "name": "AGENT_TRIGGER_RATE_LIMITER",
                        "class_name": "AgentTriggerRateLimiter"
                    },
                    {
                        "name": "RUNTIME_RELAY",
                        "class_name": "RuntimeRelay"
                    },
                    {
                        "name": "SESSION_RELAY",
                        "class_name": "LiteSessionRelay"
                    }
                ]
            },
            "queues": {
                "producers": [
                    {
                        "binding": "EVENTS",
                        "queue": "mobius-slack-cloud-production-events"
                    }
                ],
                "consumers": [
                    {
                        "queue": "mobius-slack-cloud-production-events",
                        "max_batch_size": 1,
                        "max_retries": 5
                    }
                ]
            },
            "r2_buckets": [
                { "binding": "R2_BUCKET_APAC", "bucket_name": "mobius-cloud-production-apac-objects" },
                { "binding": "R2_BUCKET_WNAM", "bucket_name": "mobius-cloud-production-wnam-objects" }
            ]
        }
    },
    "account_id": "95af7a3d67be8c49b1619544e3ce53c0"
}
