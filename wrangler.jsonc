{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "morty-local",
    "main": "packages/worker/src/index.ts",
    "compatibility_date": "2026-09-07",
    "keep_vars": false,
    "workers_dev": true,
    "preview_urls": false,
    "observability": {
        "enabled": true,
        "logs": {
            "enabled": true,
            "invocation_logs": false
        }
    },
    "assets": {
        "binding": "ASSETS",
        "not_found_handling": "none",
        "run_worker_first": ["/morty/api/*", "/morty/ws", "/setup.md", "/pair.md", "/setup.mjs"]
    },
    "r2_buckets": [{ "binding": "CHAT_ATTACHMENTS_APAC", "bucket_name": "morty-local-apac-attachments" }],
    "durable_objects": {
        "bindings": [
            {
                "name": "CHAT_PROJECTS",
                "class_name": "ProjectDurableObject"
            }
        ]
    },
    "migrations": [
        { "tag": "v1", "new_sqlite_classes": ["BotTriggerRateLimiter"] },
        { "tag": "v2", "new_sqlite_classes": ["ProjectDurableObject"] },
        { "tag": "v3", "deleted_classes": ["BotTriggerRateLimiter"] }
    ],
    "env": {
        "staging": {
            "name": "morty-staging",
            "placement": { "mode": "off" },
            "secrets": { "required": ["MOBIUS_APP_SECRET"] },
            "routes": [
                {
                    "pattern": "morty.paradev.biz",
                    "custom_domain": true
                }
            ],
            "workers_dev": false,
            "r2_buckets": [{ "binding": "CHAT_ATTACHMENTS_APAC", "bucket_name": "morty-staging-apac-attachments" }],
            "durable_objects": {
                "bindings": [
                    {
                        "name": "CHAT_PROJECTS",
                        "class_name": "ProjectDurableObject"
                    }
                ]
            }
        },
        "production": {
            "name": "morty-production",
            "placement": { "mode": "off" },
            "secrets": { "required": ["MOBIUS_APP_SECRET"] },
            "routes": [
                {
                    "pattern": "morty.build",
                    "custom_domain": true
                }
            ],
            "workers_dev": false,
            "durable_objects": {
                "bindings": [
                    {
                        "name": "CHAT_PROJECTS",
                        "class_name": "ProjectDurableObject"
                    }
                ]
            },
            "r2_buckets": [{ "binding": "CHAT_ATTACHMENTS_APAC", "bucket_name": "morty-production-apac-attachments" }]
        }
    },
    "account_id": "95af7a3d67be8c49b1619544e3ce53c0"
}
