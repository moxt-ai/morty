{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "morty-local",
    "main": "packages/worker/src/index.ts",
    "compatibility_date": "2026-09-07",
    "keep_vars": false,
    "workers_dev": true,
    "preview_urls": false,
    "compatibility_flags": ["enable_request_signal", "nodejs_compat_do_not_populate_process_env"],
    "ratelimits": [
        { "name": "ANONYMOUS_CREATION_LIMITER", "namespace_id": "103001", "simple": { "limit": 10, "period": 60 } }
    ],
    "observability": {
        "enabled": true,
        "logs": {
            "enabled": true,
            "invocation_logs": false
        }
    },
    "assets": {
        "binding": "ASSETS",
        "not_found_handling": "none",
        "run_worker_first": ["/morty/api/*", "/setup.md", "/agent-api.md", "/agent-api/*"]
    },
    "vars": {
        "APP_ORIGIN": "http://localhost:5173",
        "MORTY_ALLOWED_ORIGINS": "[\"*\"]",
        "MORTY_SESSION_SIGNING_SECRET": "local-development-only-session-signing-secret"
    },
    "durable_objects": {
        "bindings": [
            {
                "name": "COMPUTER_RELAY",
                "class_name": "ComputerRelay"
            }
        ]
    },
    "migrations": [
        { "tag": "v1", "new_sqlite_classes": ["BotTriggerRateLimiter"] },
        { "tag": "v2", "new_sqlite_classes": ["ProjectDurableObject"] },
        { "tag": "v3", "deleted_classes": ["BotTriggerRateLimiter"] },
        { "tag": "v4", "new_sqlite_classes": ["ChatWebSocketDurableObject"] },
        { "tag": "v5", "deleted_classes": ["ChatWebSocketDurableObject"] },
        { "tag": "v6-consolidated-computer-relay", "new_sqlite_classes": ["ComputerRelay"] },
        { "tag": "v7-remove-archived-projects", "deleted_classes": ["ProjectDurableObject"] }
    ],
    "env": {
        "production": {
            "name": "morty-production",
            "ratelimits": [
                {
                    "name": "ANONYMOUS_CREATION_LIMITER",
                    "namespace_id": "103003",
                    "simple": { "limit": 10, "period": 60 }
                }
            ],
            "placement": { "mode": "off" },
            "durable_objects": {
                "bindings": [
                    {
                        "name": "COMPUTER_RELAY",
                        "class_name": "ComputerRelay"
                    }
                ]
            }
        }
    },
    "account_id": "b903018a1c3d9d9a4bd68a11eb03e764"
}
