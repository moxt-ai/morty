{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "mobius-cloud-local",
    "main": "packages/worker/src/index.ts",
    "compatibility_date": "2026-09-07",
    "keep_vars": true,
    "workers_dev": true,
    "preview_urls": false,
    "observability": {
        "enabled": true,
        "logs": {
            "enabled": true,
            "invocation_logs": true
        }
    },
    "assets": {
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/mobius-cloud/api/*", "/mobius-slack/api/*"]
    },
    "queues": {
        "producers": [{ "binding": "EVENTS", "queue": "app-slack-events" }],
        "consumers": [{ "queue": "app-slack-events", "max_batch_size": 1, "max_retries": 5 }]
    },
    "r2_buckets": [{ "binding": "ATTACHMENTS", "bucket_name": "mobius-cloud-local-attachments" }],
    "d1_databases": [
        {
            "binding": "DATABASE",
            "database_name": "mobius-cloud-local",
            "database_id": "00000000-0000-0000-0000-000000000001",
            "migrations_dir": "packages/worker/migrations"
        }
    ],
    "durable_objects": {
        "bindings": [
            {
                "name": "BOT_TRIGGER_RATE_LIMITER",
                "class_name": "BotTriggerRateLimiter"
            }
        ]
    },
    "migrations": [{ "tag": "v1", "new_sqlite_classes": ["BotTriggerRateLimiter"] }],
    "env": {
        "staging": {
            "name": "mobius-chat-staging",
            "vars": { "MOBIUS_PROJECT_D1_SHARD_ID": "apac-01", "MOBIUS_PROJECT_R2_BUCKET_ID": "apac" },
            "secrets": {
                "required": [
                    "APP_ORIGIN",
                    "AUTHENTICATION_BASE_URL",
                    "CLERK_PUBLISHABLE_KEY",
                    "CLERK_JWT_KEY",
                    "MOBIUS_BASE_URL",
                    "MOBIUS_APP_ID",
                    "MOBIUS_APP_SECRET",
                    "SLACK_MOBIUS_AUTH_TOKEN",
                    "SLACK_OAUTH_STATE_SIGNING_KEY",
                    "SLACK_SERVER_BASE_URL",
                    "SLACK_TOKEN_ENCRYPTION_KEY"
                ]
            },
            "routes": [
                {
                    "pattern": "mobius.paradev.biz",
                    "custom_domain": true
                }
            ],
            "workers_dev": false,
            "queues": {
                "producers": [
                    {
                        "binding": "EVENTS",
                        "queue": "mobius-slack-cloud-staging-events"
                    }
                ],
                "consumers": [
                    {
                        "queue": "mobius-slack-cloud-staging-events",
                        "max_batch_size": 1,
                        "max_retries": 5
                    }
                ]
            },
            "r2_buckets": [{ "binding": "ATTACHMENTS", "bucket_name": "mobius-cloud-staging-attachments" }],
            "d1_databases": [
                {
                    "binding": "DATABASE",
                    "database_name": "mobius-cloud-staging",
                    "database_id": "b36b010b-1a7e-4d44-8b56-094f4865cbf4",
                    "migrations_dir": "packages/worker/migrations"
                }
            ],
            "durable_objects": {
                "bindings": [
                    {
                        "name": "BOT_TRIGGER_RATE_LIMITER",
                        "class_name": "BotTriggerRateLimiter"
                    }
                ]
            }
        },
        "production": {
            "name": "mobius-chat-production",
            "vars": { "MOBIUS_PROJECT_D1_SHARD_ID": "apac-01", "MOBIUS_PROJECT_R2_BUCKET_ID": "apac" },
            "secrets": {
                "required": [
                    "APP_ORIGIN",
                    "AUTHENTICATION_BASE_URL",
                    "CLERK_PUBLISHABLE_KEY",
                    "CLERK_JWT_KEY",
                    "MOBIUS_BASE_URL",
                    "MOBIUS_APP_ID",
                    "MOBIUS_APP_SECRET",
                    "SLACK_MOBIUS_AUTH_TOKEN",
                    "SLACK_OAUTH_STATE_SIGNING_KEY",
                    "SLACK_SERVER_BASE_URL",
                    "SLACK_TOKEN_ENCRYPTION_KEY"
                ]
            },
            "routes": [
                {
                    "pattern": "mobius.paraflow.biz",
                    "custom_domain": true
                }
            ],
            "workers_dev": false,
            "d1_databases": [
                {
                    "binding": "DATABASE",
                    "database_name": "mobius-cloud-production",
                    "database_id": "51fc8c40-468b-4347-ab5c-3064a11f927e",
                    "migrations_dir": "packages/worker/migrations"
                }
            ],
            "durable_objects": {
                "bindings": [
                    {
                        "name": "BOT_TRIGGER_RATE_LIMITER",
                        "class_name": "BotTriggerRateLimiter"
                    }
                ]
            },
            "queues": {
                "producers": [
                    {
                        "binding": "EVENTS",
                        "queue": "mobius-slack-cloud-production-events"
                    }
                ],
                "consumers": [
                    {
                        "queue": "mobius-slack-cloud-production-events",
                        "max_batch_size": 1,
                        "max_retries": 5
                    }
                ]
            },
            "r2_buckets": [{ "binding": "ATTACHMENTS", "bucket_name": "mobius-cloud-production-attachments" }]
        }
    },
    "account_id": "95af7a3d67be8c49b1619544e3ce53c0"
}
