{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "morty-local",
    "main": "packages/worker/src/index.ts",
    "compatibility_date": "2026-09-07",
    "keep_vars": false,
    "workers_dev": true,
    "preview_urls": false,
    "compatibility_flags": ["enable_request_signal"],
    "ratelimits": [
        { "name": "ANONYMOUS_CREATION_LIMITER", "namespace_id": "103001", "simple": { "limit": 10, "period": 60 } }
    ],
    "observability": {
        "enabled": true,
        "logs": {
            "enabled": true,
            "invocation_logs": false
        }
    },
    "assets": {
        "binding": "ASSETS",
        "not_found_handling": "none",
        "run_worker_first": ["/morty/api/*", "/setup.md"]
    },
    "r2_buckets": [{ "binding": "CHAT_ATTACHMENTS_APAC", "bucket_name": "morty-local-apac-attachments" }],
    "d1_databases": [
        {
            "binding": "RELAY_DIRECTORY_DATABASE",
            "database_name": "morty-local-e2e-directory",
            "database_id": "00000000-0000-0000-0000-000000000102",
            "migrations_dir": "packages/relay/migrations/d1"
        }
    ],
    "vars": {
        "MORTY_ALLOWED_ORIGINS": "[\"*\"]",
        "MORTY_SESSION_SIGNING_SECRET": "local-development-only-session-signing-secret"
    },
    "durable_objects": {
        "bindings": [
            {
                "name": "COMPUTER_RELAY",
                "class_name": "ComputerRelay"
            }
        ]
    },
    "migrations": [
        { "tag": "v1", "new_sqlite_classes": ["BotTriggerRateLimiter"] },
        { "tag": "v2", "new_sqlite_classes": ["ProjectDurableObject"] },
        { "tag": "v3", "deleted_classes": ["BotTriggerRateLimiter"] },
        { "tag": "v4", "new_sqlite_classes": ["ChatWebSocketDurableObject"] },
        { "tag": "v5", "deleted_classes": ["ChatWebSocketDurableObject"] },
        { "tag": "v6-consolidated-computer-relay", "new_sqlite_classes": ["ComputerRelay"] }
    ],
    "env": {
        "production": {
            "name": "morty-production",
            "ratelimits": [
                {
                    "name": "ANONYMOUS_CREATION_LIMITER",
                    "namespace_id": "103003",
                    "simple": { "limit": 10, "period": 60 }
                }
            ],
            "placement": { "mode": "off" },
            "secrets": { "required": ["MORTY_SESSION_SIGNING_SECRET"] },
            "routes": [
                {
                    "pattern": "morty.build",
                    "custom_domain": true
                }
            ],
            "workers_dev": false,
            "durable_objects": {
                "bindings": [
                    {
                        "name": "COMPUTER_RELAY",
                        "class_name": "ComputerRelay"
                    }
                ]
            },
            "r2_buckets": [{ "binding": "CHAT_ATTACHMENTS_APAC", "bucket_name": "morty-production-apac-attachments" }]
        }
    },
    "account_id": "b903018a1c3d9d9a4bd68a11eb03e764"
}
