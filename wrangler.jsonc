{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "mobius-cloud-local",
    "main": "packages/worker/src/index.ts",
    "compatibility_date": "2026-09-07",
    "keep_vars": false,
    "workers_dev": true,
    "preview_urls": false,
    "observability": {
        "enabled": true,
        "logs": {
            "enabled": true,
            "invocation_logs": true
        }
    },
    "assets": {
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        "run_worker_first": [
            "/mobius-cloud/api/*",
            "/mobius-cloud/ws",
            "/mobius-slack/api/*",
            "/setup.md",
            "/pair.md",
            "/setup.mjs"
        ]
    },
    "queues": {
        "producers": [{ "binding": "EVENTS", "queue": "app-slack-events" }],
        "consumers": [{ "queue": "app-slack-events", "max_batch_size": 1, "max_retries": 5 }]
    },
    "r2_buckets": [
        { "binding": "CHAT_ATTACHMENTS_APAC", "bucket_name": "morty-local-apac-attachments" },
        { "binding": "CHAT_ATTACHMENTS_WNAM", "bucket_name": "morty-local-wnam-attachments" }
    ],
    "durable_objects": {
        "bindings": [
            {
                "name": "BOT_TRIGGER_RATE_LIMITER",
                "class_name": "BotTriggerRateLimiter"
            },
            {
                "name": "CHAT_PROJECTS",
                "class_name": "ProjectDurableObject"
            }
        ]
    },
    "migrations": [
        { "tag": "v1", "new_sqlite_classes": ["BotTriggerRateLimiter"] },
        { "tag": "v2", "new_sqlite_classes": ["ProjectDurableObject"] }
    ],
    "env": {
        "staging": {
            "name": "morty-staging",
            "placement": { "mode": "off" },
            "secrets": {
                "required": [
                    "MOBIUS_APP_SECRET",
                    "SLACK_MOBIUS_AUTH_TOKEN",
                    "SLACK_OAUTH_STATE_SIGNING_KEY",
                    "SLACK_TOKEN_ENCRYPTION_KEY"
                ]
            },
            "routes": [
                {
                    "pattern": "morty.paradev.biz",
                    "custom_domain": true
                }
            ],
            "workers_dev": false,
            "queues": {
                "producers": [
                    {
                        "binding": "EVENTS",
                        "queue": "mobius-slack-cloud-staging-events"
                    }
                ],
                "consumers": [
                    {
                        "queue": "mobius-slack-cloud-staging-events",
                        "max_batch_size": 1,
                        "max_retries": 5
                    }
                ]
            },
            "r2_buckets": [
                { "binding": "CHAT_ATTACHMENTS_APAC", "bucket_name": "morty-staging-apac-attachments" },
                { "binding": "CHAT_ATTACHMENTS_WNAM", "bucket_name": "morty-staging-wnam-attachments" }
            ],
            "durable_objects": {
                "bindings": [
                    {
                        "name": "BOT_TRIGGER_RATE_LIMITER",
                        "class_name": "BotTriggerRateLimiter"
                    },
                    {
                        "name": "CHAT_PROJECTS",
                        "class_name": "ProjectDurableObject"
                    }
                ]
            }
        },
        "production": {
            "name": "morty-production",
            "placement": { "mode": "off" },
            "secrets": {
                "required": [
                    "MOBIUS_APP_SECRET",
                    "SLACK_MOBIUS_AUTH_TOKEN",
                    "SLACK_OAUTH_STATE_SIGNING_KEY",
                    "SLACK_TOKEN_ENCRYPTION_KEY"
                ]
            },
            "routes": [
                {
                    "pattern": "morty.paraflow.biz",
                    "custom_domain": true
                }
            ],
            "workers_dev": false,
            "durable_objects": {
                "bindings": [
                    {
                        "name": "BOT_TRIGGER_RATE_LIMITER",
                        "class_name": "BotTriggerRateLimiter"
                    },
                    {
                        "name": "CHAT_PROJECTS",
                        "class_name": "ProjectDurableObject"
                    }
                ]
            },
            "queues": {
                "producers": [
                    {
                        "binding": "EVENTS",
                        "queue": "mobius-slack-cloud-production-events"
                    }
                ],
                "consumers": [
                    {
                        "queue": "mobius-slack-cloud-production-events",
                        "max_batch_size": 1,
                        "max_retries": 5
                    }
                ]
            },
            "r2_buckets": [
                { "binding": "CHAT_ATTACHMENTS_APAC", "bucket_name": "morty-production-apac-attachments" },
                { "binding": "CHAT_ATTACHMENTS_WNAM", "bucket_name": "morty-production-wnam-attachments" }
            ]
        }
    },
    "account_id": "95af7a3d67be8c49b1619544e3ce53c0"
}
