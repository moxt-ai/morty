{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "mobius-cloud-local",
    "main": "packages/worker/src/index.ts",
    "compatibility_date": "2026-09-07",
    "keep_vars": false,
    "workers_dev": true,
    "preview_urls": false,
    "observability": {
        "enabled": true,
        "logs": {
            "enabled": true,
            "invocation_logs": true
        }
    },
    "assets": {
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/mobius-cloud/api/*", "/mobius-slack/api/*", "/setup.md", "/pair.md", "/setup.mjs"]
    },
    "queues": {
        "producers": [{ "binding": "EVENTS", "queue": "app-slack-events" }],
        "consumers": [{ "queue": "app-slack-events", "max_batch_size": 1, "max_retries": 5 }]
    },
    "r2_buckets": [
        { "binding": "CHAT_ATTACHMENTS_APAC", "bucket_name": "mobius-chat-local-apac-attachments" },
        { "binding": "CHAT_ATTACHMENTS_WNAM", "bucket_name": "mobius-chat-local-wnam-attachments" }
    ],
    "d1_databases": [
        {
            "binding": "CHAT_DATABASE_APAC",
            "database_name": "mobius-chat-local-apac",
            "database_id": "00000000-0000-0000-0000-000000000002",
            "migrations_dir": "packages/worker/migrations"
        },
        {
            "binding": "CHAT_DATABASE_WNAM",
            "database_name": "mobius-chat-local-wnam",
            "database_id": "00000000-0000-0000-0000-000000000003",
            "migrations_dir": "packages/worker/migrations"
        }
    ],
    "durable_objects": {
        "bindings": [
            {
                "name": "BOT_TRIGGER_RATE_LIMITER",
                "class_name": "BotTriggerRateLimiter"
            }
        ]
    },
    "migrations": [{ "tag": "v1", "new_sqlite_classes": ["BotTriggerRateLimiter"] }],
    "env": {
        "staging": {
            "name": "mobius-chat-staging",
            "services": [
                { "binding": "MOBIUS_REGIONAL_APAC", "service": "mobius-chat-staging-apac" },
                { "binding": "MOBIUS_REGIONAL_WNAM", "service": "mobius-chat-staging-wnam" }
            ],
            "vars": { "MOBIUS_WORKER_REGION": "edge" },
            "secrets": {
                "required": [
                    "MOBIUS_APP_SECRET",
                    "SLACK_MOBIUS_AUTH_TOKEN",
                    "SLACK_OAUTH_STATE_SIGNING_KEY",
                    "SLACK_TOKEN_ENCRYPTION_KEY"
                ]
            },
            "routes": [
                {
                    "pattern": "mobius-chat.paradev.biz",
                    "custom_domain": true
                }
            ],
            "workers_dev": false,
            "queues": {
                "producers": [
                    {
                        "binding": "EVENTS",
                        "queue": "mobius-slack-cloud-staging-events"
                    }
                ],
                "consumers": [
                    {
                        "queue": "mobius-slack-cloud-staging-events",
                        "max_batch_size": 1,
                        "max_retries": 5
                    }
                ]
            },
            "r2_buckets": [
                { "binding": "CHAT_ATTACHMENTS_APAC", "bucket_name": "mobius-chat-staging-apac-attachments" },
                { "binding": "CHAT_ATTACHMENTS_WNAM", "bucket_name": "mobius-chat-staging-wnam-attachments" }
            ],
            "d1_databases": [
                {
                    "binding": "CHAT_DATABASE_APAC",
                    "database_name": "mobius-chat-staging-apac",
                    "database_id": "ccbf7137-7983-4a7d-b205-04fb82a6019a",
                    "migrations_dir": "packages/worker/migrations"
                },
                {
                    "binding": "CHAT_DATABASE_WNAM",
                    "database_name": "mobius-chat-staging-wnam",
                    "database_id": "51e83fb8-70ef-4c68-98b2-5a6481fc0fc9",
                    "migrations_dir": "packages/worker/migrations"
                }
            ],
            "durable_objects": {
                "bindings": [
                    {
                        "name": "BOT_TRIGGER_RATE_LIMITER",
                        "class_name": "BotTriggerRateLimiter"
                    }
                ]
            }
        },
        "production": {
            "name": "mobius-chat-production",
            "services": [
                { "binding": "MOBIUS_REGIONAL_APAC", "service": "mobius-chat-production-apac" },
                { "binding": "MOBIUS_REGIONAL_WNAM", "service": "mobius-chat-production-wnam" }
            ],
            "vars": { "MOBIUS_WORKER_REGION": "edge" },
            "secrets": {
                "required": [
                    "MOBIUS_APP_SECRET",
                    "SLACK_MOBIUS_AUTH_TOKEN",
                    "SLACK_OAUTH_STATE_SIGNING_KEY",
                    "SLACK_TOKEN_ENCRYPTION_KEY"
                ]
            },
            "routes": [
                {
                    "pattern": "mobius-chat.paraflow.biz",
                    "custom_domain": true
                }
            ],
            "workers_dev": false,
            "d1_databases": [
                {
                    "binding": "CHAT_DATABASE_APAC",
                    "database_name": "mobius-chat-production-apac",
                    "database_id": "698bd441-3709-43fc-994f-107e84fe74f7",
                    "migrations_dir": "packages/worker/migrations"
                },
                {
                    "binding": "CHAT_DATABASE_WNAM",
                    "database_name": "mobius-chat-production-wnam",
                    "database_id": "a614d890-971c-4b97-aaee-8e71c289c57e",
                    "migrations_dir": "packages/worker/migrations"
                }
            ],
            "durable_objects": {
                "bindings": [
                    {
                        "name": "BOT_TRIGGER_RATE_LIMITER",
                        "class_name": "BotTriggerRateLimiter"
                    }
                ]
            },
            "queues": {
                "producers": [
                    {
                        "binding": "EVENTS",
                        "queue": "mobius-slack-cloud-production-events"
                    }
                ],
                "consumers": [
                    {
                        "queue": "mobius-slack-cloud-production-events",
                        "max_batch_size": 1,
                        "max_retries": 5
                    }
                ]
            },
            "r2_buckets": [
                { "binding": "CHAT_ATTACHMENTS_APAC", "bucket_name": "mobius-chat-production-apac-attachments" },
                { "binding": "CHAT_ATTACHMENTS_WNAM", "bucket_name": "mobius-chat-production-wnam-attachments" }
            ]
        }
    },
    "account_id": "95af7a3d67be8c49b1619544e3ce53c0"
}
