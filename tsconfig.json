{
    "compilerOptions": {
        "module": "esnext",
        "target": "es2024",
        "types": [],
        "rewriteRelativeImportExtensions": true,
        "verbatimModuleSyntax": true,
        "erasableSyntaxOnly": true,
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "exactOptionalPropertyTypes": true,
        "noPropertyAccessFromIndexSignature": true,
        "noFallthroughCasesInSwitch": true,
        "noImplicitOverride": true,
        "noImplicitReturns": true,
        "moduleResolution": "bundler",
        "paths": {
            "@/*": ["./packages/web/src/*"],
            "@moxt-ai/mobius-protocol": ["./third-party/mobius/packages/protocol/src/index.ts"],
            "@moxt-ai/mobius-sdk": ["./third-party/mobius/packages/web-sdk/src/index.ts"],
            "@moxt-ai/mobius-sdk/platform": ["./third-party/mobius/packages/web-sdk/src/platform.ts"],
            "@moxt-ai/mobius-sdk/channel": ["./third-party/mobius/packages/web-sdk/src/channel.ts"]
        },
        "lib": ["es2024"],
        "noEmit": true,
        "skipLibCheck": true
    },
    "include": ["packages/worker/src/**/*.ts", "shared/**/*.ts", "worker-configuration.d.ts"]
}
