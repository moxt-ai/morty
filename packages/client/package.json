{
    "name": "@morty-build/client",
    "version": "0.0.176",
    "description": "Internal Morty protocol and service clients.",
    "type": "module",
    "types": "./src/index.ts",
    "exports": {
        ".": "./src/index.ts",
        "./channel": "./src/channel.ts",
        "./platform": "./src/platform.ts",
