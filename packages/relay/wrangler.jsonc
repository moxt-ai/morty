{
    "$schema": "../../node_modules/wrangler/config-schema.json",
    "name": "morty-relay-local",
    "main": "src/worker.ts",
    "compatibility_date": "2026-09-03",
    "compatibility_flags": ["enable_request_signal"],
    "durable_objects": {
        "bindings": [
            {
                "name": "COMPUTER_RELAY",
                "class_name": "ComputerRelay"
            }
        ]
    },
    "migrations": [
        {
            "tag": "platform-initial",
            "new_sqlite_classes": ["RuntimeRelay", "PlatformSessionRelay", "BotConnectionActor"]
        },
        {
            "tag": "platform-project-relay",
            "new_sqlite_classes": ["ProjectRelay"]
        },
        {
            "tag": "platform-remove-bot-connections",
            "deleted_classes": ["BotConnectionActor"]
        },
        {
            "tag": "platform-non-cloud-retention-session-relay",
            "new_sqlite_classes": ["NonCloudRetentionSessionRelayDO"]
        },
        {
            "tag": "platform-remove-non-cloud-retention-session-relay",
            "deleted_classes": ["NonCloudRetentionSessionRelayDO"]
        },
        {
            "tag": "platform-recreate-non-cloud-retention-session-relay",
            "new_sqlite_classes": ["NonCloudRetentionSessionRelayDO"]
        },
        {
            "tag": "platform-remove-legacy-session-relays",
            "deleted_classes": ["PlatformSessionRelay", "NonCloudRetentionSessionRelayDO"]
        },
        {
            "tag": "platform-rename-project-do",
            "renamed_classes": [
                {
                    "from": "ProjectRelay",
                    "to": "ProjectDO"
                }
            ]
        },
        {
            "tag": "platform-websocket-transport",
            "new_sqlite_classes": ["WebSocketTransport"]
        },
        {
            "tag": "platform-runtime-browser-transport",
            "deleted_classes": ["WebSocketTransport"]
        },
        { "tag": "computer-relay", "new_sqlite_classes": ["ComputerRelay"] }
    ],
    "d1_databases": [
        {
            "binding": "RELAY_DIRECTORY_DATABASE",
            "migrations_dir": "migrations/d1"
        }
    ],
    "vars": {
        "MORTY_ALLOWED_ORIGINS": "[\"*\"]",
        "MORTY_SESSION_SIGNING_SECRET": "local-development-only-session-signing-secret"
    },
    "observability": {
        "enabled": true,
        "logs": {
            "invocation_logs": false
        }
    },
    "account_id": "b903018a1c3d9d9a4bd68a11eb03e764"
}
