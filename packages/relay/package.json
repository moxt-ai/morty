{
    "name": "@morty-build/relay",
    "version": "0.0.1",
    "license": "Apache-2.0",
    "type": "module",
    "exports": {
        ".": "./src/platform-worker.ts"
    },
    "scripts": {
        "prebuild": "pnpm --dir ../.. db:codegen",
        "build": "wrangler deploy --dry-run --config wrangler.jsonc --outdir dist",
        "dev": "wrangler dev --config wrangler.jsonc",
        "pretest:integration": "pnpm --dir ../.. db:codegen",
        "pretypecheck": "pnpm --dir ../.. db:codegen",
        "test:integration": "vitest run --config vitest.config.ts --max-workers=1 --no-isolate",
        "typecheck": "tsc --project tsconfig.json && tsc --project tsconfig.vitest.json && tsc --project test/tsconfig.json"
    },
    "dependencies": {
        "@morty-build/relay-core": "workspace:*",
        "drizzle-orm": "catalog:",
        "hono": "catalog:",
        "valibot": "catalog:"
    },
    "devDependencies": {
        "@cloudflare/vitest-plugin": "^1.4.9",
        "@cloudflare/workers-types": "^5.20261028.1",
        "@morty-build/client": "workspace:*",
        "vitest": "catalog:",
        "wrangler": "catalog:"
    },
    "private": true
}
