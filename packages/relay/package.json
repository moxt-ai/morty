{
    "name": "@morty-build/relay",
    "version": "0.0.1",
    "license": "Apache-2.0",
    "type": "module",
    "exports": {
        ".": "./src/index.ts",
        "./contracts": "./src/contracts.ts",
        "./database": "./src/infra/sql-database.ts",
        "./durable-object-migrations": "./src/infra/durable-object-migrations.ts",
        "./logging": "./src/infra/logger.ts",
        "./project-store": "./src/components/management/storage/sqlite-project-store.ts",
        "./schema/project-do": "./src/schema/project-do/index.ts",
        "./http": "./src/components/runtime/http/session-routes.ts",
        "./services": "./src/composition/relay-access-services.ts"
    },
    "scripts": {
        "pretest:integration": "pnpm --dir ../.. db:codegen",
        "pretypecheck": "pnpm --dir ../.. db:codegen",
        "test:integration": "vitest run --config vitest.config.ts --max-workers=1 --no-isolate",
        "typecheck": "tsc --project tsconfig.json && tsc --project tsconfig.vitest.json && tsc --project test/tsconfig.json"
    },
    "dependencies": {
        "@morty-build/client": "workspace:*",
        "drizzle-orm": "catalog:",
        "hono": "catalog:",
        "pino": "catalog:",
        "valibot": "catalog:"
    },
    "devDependencies": {
        "@cloudflare/vitest-plugin": "^1.4.9",
        "@cloudflare/workers-types": "^5.20261028.1",
        "vitest": "catalog:"
    },
    "private": true
}
