{
    "name": "@morty-build/cli",
    "version": "0.4.1",
    "description": "Morty CLI for installing, pairing, and operating the Morty background service.",
    "type": "module",
    "bin": {
        "morty": "dist/cli.js"
    },
    "files": [
        "dist",
        "LICENSE",
        "NOTICE",
        "THIRD-PARTY-NOTICES.txt"
    ],
    "engines": {
        "node": "^22.19.0 || ^24.20.0"
    },
    "publishConfig": {
        "access": "public"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/moxt-ai/morty.git",
        "directory": "packages/cli"
    },
    "scripts": {
        "prebuild": "tsc --project src/engine/acp/harness/claude/upstream/tsconfig.json && tsc --project src/engine/acp/harness/pi/upstream/tsconfig.json",
        "build": "node scripts/build.ts",
        "pretypecheck": "tsc --project src/engine/acp/harness/claude/upstream/tsconfig.json && tsc --project src/engine/acp/harness/pi/upstream/tsconfig.json",
        "start": "node dist/cli.js",
        "typecheck": "tsc --project tsconfig.json && tsc --project tests/tsconfig.json",
        "pretest:controlled": "pnpm build && pnpm pack:test",
        "test:controlled": "vitest run tests/sessions tests/runtime",
        "pretest:agents": "pnpm build && pnpm pack:test",
        "test:agents": "vitest run tests/agents --maxWorkers=2",
        "pack:test": "node scripts/pack-test-release.ts"
    },
    "dependencies": {
        "undici": "8.12.4"
    },
    "devDependencies": {
        "@agentclientprotocol/sdk": "catalog:",
        "@anthropic-ai/claude-agent-sdk": "0.3.319",
        "@anthropic-ai/sdk": "1.6.0",
        "@morty-build/client": "workspace:*",
        "@morty-build/relay-test-support": "workspace:*",
        "@types/node": "catalog:",
        "@types/semver": "^7.8.0",
        "@types/ws": "^8.18.2",
        "commander": "15.0.0",
        "drizzle-kit": "1.0.0-rc.4",
        "drizzle-orm": "1.0.0-rc.4",
        "esbuild": "catalog:",
        "semver": "^7.8.6",
        "valibot": "catalog:",
        "ws": "^8.22.1",
        "zod": "^4.6.7",
        "jsqr": "catalog:",
        "pngjs": "catalog:",
        "qrcode": "catalog:",
        "@types/pngjs": "catalog:",
        "@types/qrcode": "catalog:"
    },
    "keywords": [],
    "author": "The Morty Authors",
    "license": "Apache-2.0",
    "bugs": {
        "url": "https://github.com/moxt-ai/morty/issues"
    },
    "homepage": "https://morty.build",
    "private": false
}
