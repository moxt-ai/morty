{
    "$comment": "Modified for Morty as part of the Claude ACP adapter derived from Zed Industries' claude-code-acp (Apache-2.0).",
    "compilerOptions": {
        "declaration": true,
        "declarationMap": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "lib": ["es2024", "ESNext.Array", "ESNext.Collection", "ESNext.Iterator"],
        "module": "NodeNext",
        "moduleResolution": "Node16",
        "outDir": "dist",
        "rootDir": "src",
        "skipLibCheck": true,
        "strict": true,
        "target": "es2022",
        "types": ["node"]
    },
    "include": ["src/**/*.ts"],
    "exclude": ["node_modules", "dist"]
}
