{
    "name": "@morty-build/worker",
    "version": "0.0.1",
    "license": "Apache-2.0",
    "private": true,
    "type": "module",
    "scripts": {
        "db:codegen": "node ../../scripts/generate-sql-modules.ts",
        "pretest": "pnpm db:codegen && pnpm --filter @morty-build/cli build && pnpm --filter @morty-build/cli pack:test",
        "pretypecheck": "pnpm db:codegen",
        "pretypecheck:tests": "pnpm db:codegen",
        "typecheck": "tsc --project tsconfig.json",
        "typecheck:tests": "tsc --project tests/tsconfig.json && tsc --project tests/relay/tsconfig.json",
        "test:relay": "vitest run --config vitest.relay.config.ts --max-workers=1 --no-isolate",
        "test": "vitest run --config vitest.config.ts"
    },
    "devDependencies": {
        "@cloudflare/vitest-plugin": "^1.4.9",
        "@cloudflare/workers-types": "^5.20261028.1",
        "@morty-build/relay-test-support": "workspace:*",
        "esbuild": "catalog:",
        "miniflare": "catalog:"
    },
    "dependencies": {
        "@morty-build/client": "workspace:*",
        "@valibot/to-json-schema": "catalog:",
        "drizzle-orm": "catalog:",
        "hono": "catalog:",
        "pino": "catalog:",
        "valibot": "catalog:"
    }
}
