{
    "name": "@moxt-ai/mobius-cloud-worker",
    "version": "0.0.1",
    "private": true,
    "type": "module",
    "scripts": {
        "typecheck": "tsc --project tsconfig.json",
        "typecheck:tests": "tsc --project tests/tsconfig.json",
        "test": "vitest run --config vitest.config.ts --passWithNoTests",
        "test:changed": "vitest run --config vitest.config.ts --changed=origin/main --passWithNoTests",
        "test:coverage": "vitest run --config vitest.config.ts --coverage --passWithNoTests",
        "test:watch": "vitest --config vitest.config.ts"
    },
    "devDependencies": {
        "@cloudflare/vitest-plugin": "^1.1.4",
        "@moxt-ai/mobius-test": "link:../../third-party/mobius/tests",
        "esbuild": "0.25.12",
        "miniflare": "5.20260903.0-alpha"
    },
    "dependencies": {
        "@clerk/backend": "3.17.1",
        "@moxt-ai/mobius-sdk": "link:../../third-party/mobius/packages/mobius-sdk",
        "hono": "^4.13.5",
        "pino": "^10.3.1",
        "valibot": "1.4.2"
    }
}
