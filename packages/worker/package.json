{
    "name": "@moxt-ai/morty-worker",
    "version": "0.0.1",
    "private": true,
    "type": "module",
    "scripts": {
        "db:generate:project-do": "drizzle-kit generate --config ../../drizzle/drizzle.project-do.config.ts",
        "mobius:codegen": "node ../../third-party/mobius/scripts/generate-sql-modules.ts",
        "pretest": "pnpm mobius:codegen",
        "pretypecheck": "pnpm mobius:codegen",
        "pretypecheck:tests": "pnpm mobius:codegen",
        "typecheck": "tsc --project tsconfig.json",
        "typecheck:tests": "tsc --project tests/tsconfig.json",
        "test": "vitest run --config vitest.config.ts --passWithNoTests",
        "test:changed": "vitest run --config vitest.config.ts --changed=origin/main --passWithNoTests",
        "test:coverage": "vitest run --config vitest.config.ts --coverage --passWithNoTests",
        "test:watch": "vitest --config vitest.config.ts"
    },
    "devDependencies": {
        "@moxt-ai/mobius-test": "link:../../third-party/mobius/tests",
        "drizzle-kit": "catalog:",
        "esbuild": "catalog:",
        "miniflare": "catalog:"
    },
    "dependencies": {
        "@clerk/backend": "catalog:",
        "@moxt-ai/mobius-sdk": "catalog:",
        "@moxt-ai/mobius-protocol": "catalog:",
        "drizzle-orm": "catalog:",
        "hono": "catalog:",
        "pino": "catalog:",
        "valibot": "catalog:"
    }
}
