{
    "name": "@morty-build/worker",
    "version": "0.0.1",
    "license": "Apache-2.0",
    "private": true,
    "type": "module",
    "scripts": {
        "db:codegen": "node ../../scripts/generate-sql-modules.ts",
        "pretest": "pnpm db:codegen && pnpm --filter @morty-build/cli build && pnpm --filter @morty-build/cli pack:test",
        "pretypecheck": "pnpm db:codegen",
        "pretypecheck:tests": "pnpm db:codegen",
        "typecheck": "tsc --project tsconfig.json",
        "typecheck:tests": "tsc --project tests/tsconfig.json",
        "test": "vitest run --config vitest.config.ts --passWithNoTests",
        "test:changed": "vitest run --config vitest.config.ts --changed=origin/main --passWithNoTests",
        "test:coverage": "vitest run --config vitest.config.ts --coverage --passWithNoTests",
        "test:watch": "vitest --config vitest.config.ts"
    },
    "devDependencies": {
        "@morty-build/relay-test-support": "workspace:*",
        "esbuild": "catalog:",
        "miniflare": "catalog:"
    },
    "dependencies": {
        "@morty-build/client": "workspace:*",
        "@morty-build/relay": "workspace:*",
        "@morty-build/relay-core": "workspace:*",
        "drizzle-orm": "catalog:",
        "hono": "catalog:",
        "pino": "catalog:",
        "valibot": "catalog:"
    }
}
