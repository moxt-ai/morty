{
    "$schema": "../../../node_modules/wrangler/config-schema.json",
    "name": "morty-platform-local-e2e",
    "main": "local-platform-worker.ts",
    "compatibility_date": "2026-09-03",
    "kv_namespaces": [{ "binding": "APP_CREDENTIAL_CACHE" }],
    "durable_objects": {
        "bindings": [{ "name": "COMPUTER_RELAY", "class_name": "ComputerRelay" }]
    },
    "migrations": [
        {
            "tag": "platform-initial",
            "new_sqlite_classes": ["RuntimeRelay", "ProjectRelay"]
        },
        { "tag": "platform-rename-project-do", "renamed_classes": [{ "from": "ProjectRelay", "to": "ProjectDO" }] },
        { "tag": "platform-websocket-transport", "new_sqlite_classes": ["WebSocketTransport"] },
        { "tag": "platform-runtime-browser-transport", "deleted_classes": ["WebSocketTransport"] },
        { "tag": "computer-relay", "new_sqlite_classes": ["ComputerRelay"] }
    ],
    "d1_databases": [
        {
            "binding": "PLATFORM_DIRECTORY_DATABASE",
            "database_name": "morty-platform-e2e-directory",
            "database_id": "00000000-0000-0000-0000-000000000102",
            "migrations_dir": "../../../packages/relay/migrations/d1"
        }
    ],
    "r2_buckets": [
        { "binding": "R2_BUCKET_APAC", "bucket_name": "morty-platform-local-e2e-objects" },
        { "binding": "R2_BUCKET_WNAM", "bucket_name": "morty-platform-local-e2e-wnam-objects" }
    ],
    "vars": {
        "MORTY_ALLOWED_ORIGINS": "[\"*\"]",
        "SESSION_ACTIVE_SESSIONS_PER_PROJECT": "1000",
        "SESSION_ARCHIVE_BYTES_PER_SESSION": "268435456"
    }
}
