{
    "$schema": "../../../third-party/mobius/node_modules/wrangler/config-schema.json",
    "name": "mobius-platform-local-e2e",
    "main": "local-platform-worker.ts",
    "compatibility_date": "2026-09-03",
    "kv_namespaces": [{ "binding": "APP_CREDENTIAL_CACHE" }],
    "durable_objects": {
        "bindings": [
            { "name": "RUNTIME_RELAY", "class_name": "RuntimeRelay" },
            { "name": "PROJECT_RELAY", "class_name": "ProjectDO" },
            { "name": "WEBSOCKET_TRANSPORT", "class_name": "WebSocketTransport" }
        ]
    },
    "migrations": [
        {
            "tag": "platform-initial",
            "new_sqlite_classes": ["RuntimeRelay", "ProjectRelay"]
        },
        { "tag": "platform-rename-project-do", "renamed_classes": [{ "from": "ProjectRelay", "to": "ProjectDO" }] },
        { "tag": "platform-websocket-transport", "new_sqlite_classes": ["WebSocketTransport"] }
    ],
    "d1_databases": [
        {
            "binding": "PLATFORM_DIRECTORY_DATABASE",
            "database_name": "mobius-platform-e2e-directory",
            "database_id": "00000000-0000-0000-0000-000000000102",
            "migrations_dir": "../../../third-party/mobius/packages/relay-cloudflare-platform/migrations/d1"
        }
    ],
    "r2_buckets": [
        { "binding": "R2_BUCKET_APAC", "bucket_name": "mobius-platform-local-e2e-objects" },
        { "binding": "R2_BUCKET_WNAM", "bucket_name": "mobius-platform-local-e2e-wnam-objects" }
    ],
    "vars": {
        "MOBIUS_PLATFORM_ALLOWED_ORIGINS": "[\"*\"]",
        "MOBIUS_PLATFORM_OIDC_PROVIDERS": "[]",
        "MOBIUS_PLATFORM_OPERATOR_SUBJECTS": "[]",
        "MOBIUS_SESSION_WEBHOOK_SECRET_ENCRYPTION_KEY": "AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8=",
        "SESSION_ACTIVE_SESSIONS_PER_PROJECT": "1000",
        "SESSION_ARCHIVE_BYTES_PER_SESSION": "268435456"
    }
}
