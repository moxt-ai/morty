{
    "$schema": "../../../node_modules/wrangler/config-schema.json",
    "name": "morty-local-e2e",
    "main": "../../../dist/morty_local/index.js",
    "compatibility_date": "2026-09-07",
    "assets": {
        "binding": "ASSETS",
        "directory": "../../../dist/client",
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/morty/api/*", "/morty/ws", "/mobius-slack/api/*", "/pair.md", "/setup.md", "/setup.mjs"]
    },
    "r2_buckets": [
        { "binding": "CHAT_ATTACHMENTS_APAC", "bucket_name": "morty-local-e2e-attachments" },
        { "binding": "CHAT_ATTACHMENTS_WNAM", "bucket_name": "morty-local-e2e-wnam-attachments" }
    ],
    "durable_objects": {
        "bindings": [
            { "name": "CHAT_PROJECTS", "class_name": "ProjectDurableObject" },
            { "name": "BOT_TRIGGER_RATE_LIMITER", "class_name": "BotTriggerRateLimiter" }
        ]
    },
    "migrations": [
        { "tag": "v1", "new_sqlite_classes": ["BotTriggerRateLimiter"] },
        { "tag": "v2", "new_sqlite_classes": ["ProjectDurableObject"] }
    ]
}
