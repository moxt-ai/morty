{
    "$schema": "../../../node_modules/wrangler/config-schema.json",
    "name": "mobius-chat-local-e2e",
    "main": "../../../dist/mobius_cloud_local/index.js",
    "compatibility_date": "2026-09-07",
    "assets": {
        "binding": "ASSETS",
        "directory": "../../../dist/client",
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/mobius-cloud/api/*", "/mobius-slack/api/*", "/pair.md", "/setup.md", "/setup.mjs"]
    },
    "r2_buckets": [
        { "binding": "CHAT_ATTACHMENTS_APAC", "bucket_name": "mobius-chat-local-e2e-attachments" },
        { "binding": "CHAT_ATTACHMENTS_WNAM", "bucket_name": "mobius-chat-local-e2e-wnam-attachments" }
    ],
    "d1_databases": [
        {
            "binding": "CHAT_DATABASE_WNAM",
            "database_name": "mobius-chat-local-e2e-wnam",
            "database_id": "00000000-0000-0000-0000-000000000202",
            "migrations_dir": "../../../packages/worker/migrations"
        },
        {
            "binding": "CHAT_DATABASE_APAC",
            "database_name": "mobius-chat-local-e2e",
            "database_id": "00000000-0000-0000-0000-000000000201",
            "migrations_dir": "../../../packages/worker/migrations"
        }
    ]
}
