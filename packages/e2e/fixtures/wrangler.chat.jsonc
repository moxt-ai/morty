{
    "$schema": "../../../node_modules/wrangler/config-schema.json",
    "name": "morty-local-e2e",
    "main": "../../../dist/morty_local/index.js",
    "compatibility_date": "2026-09-07",
    "compatibility_flags": ["enable_request_signal"],
    "vars": {
        "MORTY_ALLOWED_ORIGINS": "[\"*\"]",
        "MORTY_SESSION_SIGNING_SECRET": "local-development-only-session-signing-secret"
    },
    "ratelimits": [
        { "name": "ANONYMOUS_CREATION_LIMITER", "namespace_id": "103004", "simple": { "limit": 1000, "period": 60 } }
    ],
    "assets": {
        "binding": "ASSETS",
        "directory": "../../../dist/client",
        "not_found_handling": "none",
        "run_worker_first": ["/morty/api/*", "/setup.md", "/agent-api.md", "/agent-api/*"]
    },
    "durable_objects": {
        "bindings": [{ "name": "COMPUTER_RELAY", "class_name": "ComputerRelay" }]
    },
    "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ComputerRelay"] }]
}
