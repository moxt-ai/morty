{
    "$schema": "../../../node_modules/wrangler/config-schema.json",
    "name": "morty-local-e2e",
    "main": "../../../dist/morty_local/index.js",
    "compatibility_date": "2026-09-07",
    "compatibility_flags": ["enable_request_signal"],
    "vars": {
        "MORTY_ALLOWED_ORIGINS": "[\"*\"]",
        "MORTY_SESSION_SIGNING_SECRET": "local-development-only-session-signing-secret"
    },
    "d1_databases": [
        {
            "binding": "RELAY_DIRECTORY_DATABASE",
            "database_name": "morty-local-e2e-directory",
            "database_id": "00000000-0000-0000-0000-000000000102",
            "migrations_dir": "../../relay/migrations/d1"
        }
    ],
    "ratelimits": [
        { "name": "ANONYMOUS_CREATION_LIMITER", "namespace_id": "103004", "simple": { "limit": 1000, "period": 60 } }
    ],
    "assets": {
        "binding": "ASSETS",
        "directory": "../../../dist/client",
        "not_found_handling": "none",
        "run_worker_first": ["/morty/api/*", "/setup.md"]
    },
    "r2_buckets": [{ "binding": "CHAT_ATTACHMENTS_APAC", "bucket_name": "morty-local-e2e-attachments" }],
    "durable_objects": {
        "bindings": [{ "name": "COMPUTER_RELAY", "class_name": "ComputerRelay" }]
    },
    "migrations": [
        { "tag": "v1", "new_sqlite_classes": ["ProjectDurableObject"] },
        { "tag": "v2-consolidated-computer-relay", "new_sqlite_classes": ["ComputerRelay"] }
    ]
}
