{
    "$schema": "../../../node_modules/wrangler/config-schema.json",
    "name": "morty-local-e2e",
    "main": "../../../dist/morty_local/index.js",
    "compatibility_date": "2026-09-07",
    "assets": {
        "binding": "ASSETS",
        "directory": "../../../dist/client",
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/morty/api/*", "/morty/ws", "/setup.md", "/connect.md", "/setup.mjs"]
    },
    "r2_buckets": [{ "binding": "CHAT_ATTACHMENTS_APAC", "bucket_name": "morty-local-e2e-attachments" }],
    "durable_objects": {
        "bindings": [{ "name": "CHAT_PROJECTS", "class_name": "ProjectDurableObject" }]
    },
    "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ProjectDurableObject"] }]
}
