{
    "name": "mobius-cloud",
    "version": "0.0.1",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@11.25.0",
    "engines": {
        "node": ">=24.20.0 <25",
        "pnpm": ">=11.25.0 <12"
    },
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "typecheck": "pnpm typegen && pnpm --filter './packages/**' --recursive --if-present typecheck && pnpm --filter './packages/**' --recursive --if-present typecheck:tests",
        "check:no-chinese": "node scripts/check-no-chinese.ts",
        "lint": "biome ci --error-on-warnings && pnpm check:no-chinese",
        "lint:fix": "biome check --write --error-on-warnings && pnpm check:no-chinese",
        "format": "biome format --write",
        "test": "pnpm --recursive --if-present test",
        "test:changed": "pnpm --recursive --if-present test:changed",
        "test:watch": "pnpm --recursive --parallel --if-present test:watch",
        "test:coverage": "pnpm --filter @moxt-ai/mobius-cloud-worker test:coverage && pnpm --filter @moxt-ai/mobius-cloud-web test",
        "test:e2e:opencode": "node scripts/e2e/opencode-live.mjs",
        "knip": "knip",
        "check": "pnpm typecheck && pnpm build && pnpm lint && pnpm test:coverage && pnpm knip",
        "postinstall": "simple-git-hooks",
        "typegen": "wrangler types worker-configuration.d.ts",
        "preview": "vite preview",
        "build:staging": "CLOUDFLARE_ENV=staging vite build",
        "build:production": "CLOUDFLARE_ENV=production vite build",
        "deploy:staging": "pnpm build:staging && wrangler deploy --env staging",
        "deploy:production": "pnpm build:production && wrangler deploy --env production"
    },
    "simple-git-hooks": {
        "pre-commit": "pnpm typecheck && pnpm check:no-chinese && pnpm biome check --staged --files-ignore-unknown=true --no-errors-on-unmatched"
    },
    "devDependencies": {
        "@biomejs/biome": "2.5.12",
        "@cloudflare/vite-plugin": "1.54.4",
        "@sentry/vite-plugin": "^5.4.0",
        "@tailwindcss/vite": "^4.3.3",
        "@types/node": "^24.13.3",
        "@types/react": "^19.2.18",
        "@vitejs/plugin-react": "^6.1.1",
        "@vitest/coverage-v8": "^4.1.10",
        "happy-dom": "20.8.9",
        "knip": "^6.32.2",
        "playwright-core": "^1.63.0",
        "simple-git-hooks": "^2.13.1",
        "typescript": "^7.0.2",
        "vite": "^8.2.2",
        "vitest": "^4.1.10",
        "wrangler": "4.129.0"
    },
    "dependencies": {
        "react": "^19.2.8",
        "valibot": "1.4.2"
    }
}
