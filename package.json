{
    "name": "mobius-cloud",
    "version": "0.0.1",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@11.25.0",
    "engines": {
        "node": ">=24.20.0 <25",
        "pnpm": ">=11.25.0 <12"
    },
    "scripts": {
        "dev": "vite",
        "build": "pnpm build:setup && vite build",
        "build:setup": "pnpm --filter @moxt-ai/mobius-chat-setup build",
        "publish:web-assets": "bash scripts/publish-web-assets.sh",
        "typecheck": "pnpm typegen && pnpm --filter './packages/**' --recursive --if-present typecheck && pnpm --filter './packages/**' --recursive --if-present typecheck:tests",
        "check:no-chinese": "node scripts/check-no-chinese.ts",
        "lint": "biome ci --error-on-warnings && pnpm check:no-chinese && pnpm check:architecture",
        "check:architecture": "depcruise --config dependency-cruiser.config.cjs packages/web/src packages/worker/src",
        "lint:fix": "biome check --write --error-on-warnings && pnpm check:no-chinese",
        "format": "biome format --write",
        "test": "pnpm --recursive --if-present test",
        "test:changed": "pnpm --recursive --if-present test:changed",
        "test:watch": "pnpm --recursive --parallel --if-present test:watch",
        "test:coverage": "node scripts/coverage.mjs",
        "test:coverage:merge": "node scripts/coverage.mjs --merge-only",
        "test:worker": "pnpm --dir packages/worker exec vitest run --coverage",
        "test:e2e": "pnpm --filter @moxt-ai/mobius-chat-e2e test",
        "test:e2e:codex": "node scripts/e2e/codex-live.mjs",
        "test:e2e:opencode": "node scripts/e2e/opencode-live.mjs",
        "knip": "knip",
        "check:static": "pnpm typecheck && pnpm build && pnpm lint && pnpm knip",
        "ci:check": "pnpm check:static && pnpm test:coverage",
        "postinstall": "simple-git-hooks",
        "typegen": "wrangler types worker-configuration.d.ts",
        "preview": "vite preview",
        "build:staging": "pnpm build:setup && CLOUDFLARE_ENV=staging vite build",
        "build:production": "pnpm build:setup && CLOUDFLARE_ENV=production vite build",
        "deploy:staging": "pnpm build:staging && wrangler deploy --env staging",
        "deploy:production": "pnpm build:production && wrangler deploy --env production"
    },
    "simple-git-hooks": {
        "pre-commit": "pnpm typecheck && pnpm check:no-chinese && pnpm biome check --staged --files-ignore-unknown=true --no-errors-on-unmatched"
    },
    "devDependencies": {
        "@biomejs/biome": "2.5.12",
        "@cloudflare/vite-plugin": "1.54.4",
        "@sentry/vite-plugin": "^5.4.0",
        "@tailwindcss/vite": "^4.3.3",
        "@types/node": "^24.13.3",
        "@types/react": "^19.2.18",
        "@vitejs/plugin-react": "^6.1.1",
        "@vitest/coverage-istanbul": "4.1.11",
        "dependency-cruiser": "18.2.0",
        "happy-dom": "20.8.9",
        "istanbul-lib-coverage": "3.2.2",
        "istanbul-lib-report": "3.0.1",
        "istanbul-reports": "3.2.0",
        "knip": "^6.32.2",
        "playwright-core": "^1.63.0",
        "simple-git-hooks": "^2.13.1",
        "typescript": "^7.0.2",
        "vite": "^8.2.2",
        "vitest": "^4.1.11",
        "wrangler": "4.129.0"
    },
    "dependencies": {
        "base64-js": "^1.5.1",
        "react": "^19.2.8",
        "valibot": "1.4.2"
    }
}
