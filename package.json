{
  "name": "mobius-cloud",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.20.0 <25",
    "pnpm": ">=11.25.0 <12"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "pnpm typegen && tsc --project tests/tsconfig.json && pnpm --filter @moxt-ai/mobius-cloud-web-core --filter @moxt-ai/mobius-cloud-web typecheck",
    "check:no-chinese": "node scripts/check-no-chinese.ts",
    "lint": "biome ci --error-on-warnings && pnpm check:no-chinese",
    "lint:fix": "biome check --write --error-on-warnings && pnpm check:no-chinese",
    "format": "biome format --write",
    "test": "vitest run --passWithNoTests",
    "test:changed": "vitest run --changed=origin/main --passWithNoTests",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "knip": "knip",
    "check": "pnpm typecheck && pnpm build && pnpm lint && pnpm test:coverage && pnpm test:browser && pnpm knip",
    "postinstall": "simple-git-hooks",
    "typegen": "wrangler types worker-configuration.d.ts",
    "preview": "vite preview",
    "build:staging": "CLOUDFLARE_ENV=staging vite build",
    "build:production": "CLOUDFLARE_ENV=production vite build",
    "deploy:staging": "pnpm build:staging && wrangler deploy",
    "deploy:production": "pnpm build:production && wrangler deploy",
    "test:browser": "vitest run --config vitest.browser.config.ts"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm typecheck && pnpm check:no-chinese && pnpm biome check --staged --files-ignore-unknown=true --no-errors-on-unmatched"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "@cloudflare/vite-plugin": "1.54.4",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/browser-playwright": "4.1.11",
    "@vitest/coverage-v8": "^4.1.10",
    "knip": "^6.32.2",
    "playwright": "1.63.0",
    "simple-git-hooks": "^2.13.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.10",
    "vitest-browser-react": "^2.3.0",
    "wrangler": "4.129.0"
  },
  "dependencies": {
    "@clerk/backend": "3.17.1",
    "@clerk/react": "6.15.1",
    "@moxt-ai/app-slack-api": "workspace:*",
    "@moxt-ai/app-slack-web-core": "workspace:*",
    "@moxt-ai/mobius-cloud-web-core": "workspace:*",
    "@moxt-ai/mobius-protocol": "workspace:*",
    "@moxt-ai/mobius-relay-cloudflare": "workspace:*",
    "@moxt-ai/mobius-relay-core": "workspace:*",
    "@moxt-ai/mobius-web-core": "workspace:*",
    "@moxt-ai/mobius-web-sdk": "workspace:*",
    "@tanstack/react-router": "1.170.32",
    "@radix-ui/react-select": "2.3.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.39.0",
    "pino": "^10.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "streamdown": "2.5.0",
    "tailwind-merge": "^3.6.0",
    "valibot": "1.4.2",
    "zustand": "^5.0.15"
  }
}
