{
    "name": "morty",
    "version": "0.0.1",
    "license": "Apache-2.0",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@11.25.0",
    "engines": {
        "node": ">=24.20.0 <25",
        "pnpm": ">=11.25.0 <12"
    },
    "scripts": {
        "dev": "vite",
        "local-dev": "node scripts/local-dev.cjs",
        "build": "pnpm build:setup && vite build",
        "build:setup": "pnpm --filter @morty-build/setup build",
        "typecheck": "pnpm typegen && pnpm --filter './packages/**' --recursive --if-present typecheck && pnpm --filter './packages/**' --recursive --if-present typecheck:tests && pnpm typecheck:tooling",
        "check:no-chinese": "node scripts/check-no-chinese.ts",
        "check:store-subscribe": "node scripts/check-store-subscribe.ts",
        "check:view-hooks": "node scripts/check-view-hooks.ts",
        "lint": "biome ci --error-on-warnings && pnpm check:no-chinese && pnpm check:store-subscribe && pnpm check:view-hooks && pnpm check:architecture && pnpm check:runtime-architecture",
        "check:architecture": "depcruise --config dependency-cruiser.config.cjs packages/web/src packages/worker/src",
        "lint:fix": "biome check --write --error-on-warnings && pnpm check:no-chinese && pnpm check:architecture",
        "format": "biome format --write",
        "test": "pnpm test:client && pnpm test:web && pnpm test:worker",
        "test:changed": "pnpm --recursive --if-present test:changed",
        "test:watch": "pnpm --recursive --parallel --if-present test:watch",
        "test:coverage": "node scripts/coverage.mjs",
        "test:coverage:merge": "node scripts/coverage.mjs --merge-only",
        "test:worker": "pnpm --dir packages/worker test",
        "test:web": "pnpm --dir packages/web test",
        "test:e2e": "pnpm --filter @morty-build/e2e test",
        "knip": "knip",
        "check:static": "pnpm typecheck && pnpm build && pnpm lint && pnpm knip",
        "ci:check": "pnpm check:static && pnpm test:client && pnpm test:coverage",
        "postinstall": "pnpm db:codegen && simple-git-hooks",
        "typegen": "wrangler types worker-configuration.d.ts",
        "preview": "vite preview",
        "build:production": "python3 deployment/build.py production",
        "typecheck:tooling": "tsc --project tsconfig.tooling.json",
        "db:generate:relay-d1": "drizzle-kit generate --config drizzle/drizzle.relay-d1.config.ts",
        "db:generate:cli-acp-session-store": "drizzle-kit generate --config drizzle/drizzle.cli-acp-session-store.config.ts && pnpm db:codegen",
        "db:generate:cli-session-event-cache": "pnpm --filter @morty-build/cli exec drizzle-kit generate --config ../../drizzle/drizzle.cli-session-event-cache.config.ts && pnpm db:codegen",
        "db:generate:project-do": "drizzle-kit generate --config drizzle/drizzle.project-do.config.ts && pnpm db:codegen",
        "db:generate:worker-project-do": "drizzle-kit generate --config drizzle/drizzle.worker-project-do.config.ts && pnpm db:codegen",
        "db:generate:runtime-connection-do": "drizzle-kit generate --config drizzle/drizzle.runtime-connection-do.config.ts && pnpm db:codegen",
        "db:codegen": "node scripts/generate-sql-modules.ts",
        "build:cli": "pnpm --filter @morty-build/cli build",
        "test:runtime": "pnpm --filter @morty-build/cli test:controlled",
        "test:relay": "pnpm --filter @morty-build/relay test:integration",
        "check:runtime-architecture": "node scripts/check-runtime-architecture.ts",
        "test:client": "vitest run packages/client/tests",
        "test:relay-support": "vitest run packages/relay-test-support/tests"
    },
    "simple-git-hooks": {
        "pre-commit": "pnpm typecheck && pnpm check:no-chinese && pnpm check:view-hooks && pnpm biome check --error-on-warnings --staged --files-ignore-unknown=true --no-errors-on-unmatched && pnpm check:architecture"
    },
    "devDependencies": {
        "@agentclientprotocol/sdk": "catalog:",
        "@biomejs/biome": "catalog:",
        "@cloudflare/vite-plugin": "catalog:",
        "@morty-build/cli": "workspace:*",
        "@morty-build/client": "workspace:*",
        "@morty-build/runtime-test-support": "workspace:*",
        "@sentry/vite-plugin": "catalog:",
        "@tailwindcss/vite": "catalog:",
        "@types/node": "catalog:",
        "@types/ws": "^8.18.2",
        "@vitejs/plugin-react": "catalog:",
        "@vitest/coverage-istanbul": "catalog:",
        "dependency-cruiser": "catalog:",
        "drizzle-kit": "catalog:",
        "esbuild": "catalog:",
        "happy-dom": "catalog:",
        "istanbul-lib-coverage": "catalog:",
        "istanbul-lib-report": "catalog:",
        "istanbul-reports": "catalog:",
        "knip": "catalog:",
        "playwright-core": "catalog:",
        "simple-git-hooks": "catalog:",
        "typescript": "catalog:",
        "vite": "catalog:",
        "vitest": "catalog:",
        "wrangler": "catalog:",
        "ws": "^8.22.1",
        "@electron/asar": "4.3.1",
        "drizzle-orm": "catalog:"
    },
    "dependencies": {
        "valibot": "catalog:"
    }
}
