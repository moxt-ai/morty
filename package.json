{
    "name": "morty",
    "version": "0.0.1",
    "license": "Apache-2.0",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@11.25.0",
    "engines": {
        "node": ">=24.20.0 <25",
        "pnpm": ">=11.25.0 <12"
    },
    "scripts": {
        "dev": "vite",
        "local-dev": "node scripts/local-dev.cjs",
        "sync:submodules": "node scripts/sync-submodules.cjs",
        "build": "pnpm build:setup && vite build",
        "build:setup": "pnpm --filter @moxt-ai/morty-setup build",
        "publish:web-assets": "bash scripts/publish-web-assets.sh",
        "typecheck": "pnpm typegen && pnpm --filter './packages/**' --recursive --if-present typecheck && pnpm --filter './packages/**' --recursive --if-present typecheck:tests && pnpm typecheck:tooling",
        "check:no-chinese": "node scripts/check-no-chinese.ts",
        "check:store-subscribe": "node scripts/check-store-subscribe.ts",
        "check:view-hooks": "node scripts/check-view-hooks.ts",
        "lint": "biome ci --error-on-warnings && pnpm check:no-chinese && pnpm check:store-subscribe && pnpm check:view-hooks && pnpm check:architecture",
        "check:architecture": "depcruise --config dependency-cruiser.config.cjs packages/web/src packages/worker/src",
        "lint:fix": "biome check --write --error-on-warnings && pnpm check:no-chinese && pnpm check:architecture",
        "format": "biome format --write",
        "test": "pnpm test:web && pnpm test:worker && pnpm test:web-assets",
        "test:changed": "pnpm --recursive --if-present test:changed",
        "test:watch": "pnpm --recursive --parallel --if-present test:watch",
        "test:coverage": "node scripts/coverage.mjs && pnpm test:web-assets",
        "test:coverage:merge": "node scripts/coverage.mjs --merge-only",
        "test:worker": "pnpm --dir packages/worker test",
        "test:web": "pnpm --dir packages/web test",
        "test:e2e": "pnpm --filter @moxt-ai/morty-e2e test",
        "test:web-assets": "node --test scripts/publish-web-assets.integration.test.cjs",
        "knip": "knip",
        "check:static": "pnpm typecheck && pnpm build && pnpm lint && pnpm knip",
        "ci:check": "pnpm check:static && pnpm test:coverage",
        "postinstall": "simple-git-hooks",
        "typegen": "wrangler types worker-configuration.d.ts",
        "preview": "vite preview",
        "build:staging": "pnpm build:setup && CLOUDFLARE_ENV=staging vite build",
        "build:production": "pnpm build:setup && CLOUDFLARE_ENV=production vite build",
        "deploy:staging": "pnpm build:staging && wrangler deploy --env staging",
        "deploy:production": "pnpm build:production && wrangler deploy --env production",
        "typecheck:tooling": "tsc --project tsconfig.tooling.json"
    },
    "simple-git-hooks": {
        "pre-commit": "pnpm typecheck && pnpm check:no-chinese && pnpm check:view-hooks && pnpm biome check --error-on-warnings --staged --files-ignore-unknown=true --no-errors-on-unmatched && pnpm check:architecture"
    },
    "devDependencies": {
        "@agentclientprotocol/sdk": "1.4.0",
        "@biomejs/biome": "catalog:",
        "@cloudflare/vite-plugin": "catalog:",
        "@moxt-ai/mobius": "workspace:*",
        "@moxt-ai/mobius-sdk": "workspace:*",
        "@moxt-ai/mobius-test-support": "workspace:*",
        "@sentry/vite-plugin": "catalog:",
        "@tailwindcss/vite": "catalog:",
        "@types/node": "catalog:",
        "@types/react": "catalog:",
        "@types/ws": "^8.18.1",
        "@vitejs/plugin-react": "catalog:",
        "@vitest/coverage-istanbul": "catalog:",
        "dependency-cruiser": "catalog:",
        "drizzle-kit": "catalog:",
        "esbuild": "catalog:",
        "happy-dom": "catalog:",
        "istanbul-lib-coverage": "catalog:",
        "istanbul-lib-report": "catalog:",
        "istanbul-reports": "catalog:",
        "knip": "catalog:",
        "playwright-core": "catalog:",
        "simple-git-hooks": "catalog:",
        "typescript": "catalog:",
        "vite": "catalog:",
        "vitest": "catalog:",
        "wrangler": "catalog:",
        "ws": "^8.22.0"
    },
    "dependencies": {
        "react": "catalog:",
        "valibot": "catalog:"
    }
}
